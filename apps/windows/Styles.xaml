<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Colors come from Ui.cs as Sonora.* brushes so high-contrast mode can swap them. -->
 <!-- Rectangles clamp their radius to half the size, so these stay true capsules at any height. -->
 <Style x:Key="FocusRing" TargetType="Rectangle">
  <Setter Property="Stroke" Value="{DynamicResource Sonora.Signal}"/>
  <Setter Property="StrokeThickness" Value="2"/>
  <Setter Property="Margin" Value="-4"/>
  <Setter Property="RadiusX" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Sonora.Half}}"/>
  <Setter Property="RadiusY" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Sonora.Half}}"/>
  <Setter Property="Visibility" Value="Collapsed"/>
  <Setter Property="IsHitTestVisible" Value="False"/>
 </Style>

 <Style x:Key="IconButton" TargetType="Button">
  <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
  <Setter Property="Background" Value="{DynamicResource Sonora.Card}"/>
  <Setter Property="Foreground" Value="{DynamicResource Sonora.Text}"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid>
    <Rectangle x:Name="Body" Fill="{TemplateBinding Background}" RadiusX="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Sonora.Half}}" RadiusY="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Sonora.Half}}"/>
    <Rectangle x:Name="Tint" Fill="#FFFFFF" Opacity="0" RadiusX="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Sonora.Half}}" RadiusY="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Sonora.Half}}"/>
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Rectangle x:Name="Ring" Style="{StaticResource FocusRing}"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.07"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.14"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PrimaryIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
  <Setter Property="Background" Value="{DynamicResource Sonora.Text}"/>
  <Setter Property="Foreground" Value="{DynamicResource Sonora.Ink}"/>
 </Style>
 <Style x:Key="GhostIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
  <Setter Property="Background" Value="Transparent"/>
 </Style>

 <Style x:Key="Pill" TargetType="Button">
  <Setter Property="Height" Value="40"/>
  <Setter Property="Padding" Value="18,0"/>
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Background" Value="{DynamicResource Sonora.Card}"/>
  <Setter Property="Foreground" Value="{DynamicResource Sonora.Text}"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid>
    <Rectangle x:Name="Body" Fill="{TemplateBinding Background}" RadiusX="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Sonora.Half}}" RadiusY="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Sonora.Half}}"/>
    <Rectangle x:Name="Tint" Fill="#FFFFFF" Opacity="0" RadiusX="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Sonora.Half}}" RadiusY="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Sonora.Half}}"/>
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Rectangle x:Name="Ring" Style="{StaticResource FocusRing}"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.07"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.14"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PrimaryPill" TargetType="Button" BasedOn="{StaticResource Pill}">
  <Setter Property="Background" Value="{DynamicResource Sonora.Text}"/>
  <Setter Property="Foreground" Value="{DynamicResource Sonora.Ink}"/>
 </Style>

 <!-- Whole-notch button used by the idle and compact states. -->
 <Style x:Key="SurfaceButton" TargetType="Button">
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Foreground" Value="{DynamicResource Sonora.Text}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid Background="Transparent">
    <ContentPresenter/>
    <Border x:Name="Ring" BorderBrush="{DynamicResource Sonora.Signal}" BorderThickness="2" CornerRadius="0,0,14,14" Visibility="Collapsed" IsHitTestVisible="False"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- The playing track in the notch: a quiet hover behind the cover and title. -->
 <Style x:Key="TrackButton" TargetType="Button">
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Foreground" Value="{DynamicResource Sonora.Text}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid Background="Transparent">
    <Rectangle x:Name="Tint" Fill="#FFFFFF" Opacity="0" RadiusX="18" RadiusY="18" Margin="-6"/>
    <ContentPresenter/>
    <Rectangle x:Name="Ring" Stroke="{DynamicResource Sonora.Signal}" StrokeThickness="2" RadiusX="18" RadiusY="18" Margin="-6" Visibility="Collapsed" IsHitTestVisible="False"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.05"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tint" Property="Opacity" Value="0.1"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="Switch" TargetType="ToggleButton">
  <Setter Property="Width" Value="38"/><Setter Property="Height" Value="22"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Grid>
    <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource Sonora.SwitchOff}" Padding="3">
     <Ellipse x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Fill="{DynamicResource Sonora.Text}"/>
    </Border>
    <Rectangle x:Name="Ring" Style="{StaticResource FocusRing}"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True">
     <Setter TargetName="Track" Property="Background" Value="{DynamicResource Sonora.Text}"/>
     <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Sonora.Ink}"/>
     <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
    </Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style x:Key="VolumeSlider" TargetType="Slider">
  <Setter Property="Height" Value="24"/>
  <Setter Property="IsMoveToPointEnabled" Value="True"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
   <Grid Background="Transparent">
    <Border x:Name="Ring" BorderBrush="{DynamicResource Sonora.Signal}" BorderThickness="2" CornerRadius="12" Margin="-6,0" Visibility="Collapsed" IsHitTestVisible="False"/>
    <Border Height="4" CornerRadius="2" Background="{DynamicResource Sonora.Track}" VerticalAlignment="Center"/>
    <Track x:Name="PART_Track">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Sonora.Signal}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     <Track.Thumb><Thumb Width="16" Height="16" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb">
      <Ellipse Fill="#FFFFFF"><Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.5"/></Ellipse.Effect></Ellipse>
     </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    </Track>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Visibility" Value="Visible"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <Style TargetType="ToolTip">
  <Setter Property="Background" Value="#F01E1E21"/>
  <Setter Property="Foreground" Value="#F5F5F7"/>
  <Setter Property="BorderBrush" Value="#33FFFFFF"/>
  <Setter Property="Padding" Value="10,6"/>
  <Setter Property="FontSize" Value="12"/>
 </Style>
</ResourceDictionary>
